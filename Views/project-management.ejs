      <!-- User Info (always visible on desktop) -->
      <div class="user-info">
        <span class="user-name">Divya Dharshini A</span>
        <span class="user-email">divyaanand148@gmail.com</span>
      </div>


      <a href="/logout" title="Logout" style="color:white; margin-left:10px;" class="logout">
