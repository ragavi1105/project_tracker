<!-- ADJUST QTY POPUP -->
<div id="adjustQtyOverlay" onclick="closeAdjustQtyPopup()"
  style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);
  backdrop-filter:blur(4px);z-index:29500;"></div>

<div id="adjustQtyPopup"
  style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
  width:min(500px,94vw);background:#fff;border-radius:10px;
  box-shadow:0 16px 50px rgba(0,0,0,0.22);z-index:29501;overflow:hidden;">

  <!-- Header -->
  <div style="display:flex;align-items:center;justify-content:space-between;
    padding:14px 18px;border-bottom:1px solid #e5e7eb;background:var(--primary-color)">
    <div style="display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;color:#fff;">
      <i class="fa-solid fa-sliders" style="color:var(--primary);"></i>
      Manual Adjustment
    </div>
    <i class="fa-solid fa-xmark" onclick="closeAdjustQtyPopup()"
      style="cursor:pointer;font-size:16px;color:#ffffff;"></i>
  </div>

  <!-- Body -->
  <div style="padding:20px 18px;display:flex;flex-direction:column;gap:14px;">

    <!-- Part Info -->
   <div style="background:#f9fafb;border-radius:8px;padding:12px 14px;
  border:1px solid #e5e7eb;display:flex;flex-direction:column;gap:8px;">

  <!-- Row 1: Part Number + Current Qty -->
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
    <div style="display:flex;flex-direction:column;gap:3px;">
      <div style="font-size:11px;color:#6b7280;font-weight:700;text-transform:uppercase;
        letter-spacing:0.05em;">Part Number</div>
      <div id="adjustQtyPartNumber"
        style="font-size:14px;font-weight:600;color:var(--primary);"></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:3px;align-items:flex-end;">
      <div style="font-size:11px;color:#6b7280;font-weight:700;text-transform:uppercase;
        letter-spacing:0.05em;">Current Qty</div>
      <div id="adjustQtyCurrentDisplay"
        style="font-size:18px;font-weight:700;color:#2563eb;"></div>
    </div>
  </div>

  <!-- Row 2: Part Name -->
  <div style="display:flex;flex-direction:column;gap:3px;border-top:1px solid #e5e7eb;padding-top:8px;">
    <div style="font-size:11px;color:#6b7280;font-weight:700;text-transform:uppercase;
      letter-spacing:0.05em;">Part Name</div>
    <div id="adjustQtyPartName"
      style="font-size:13px;color:#374151;"></div>
  </div>

</div>

<!-- Adjustment Controls -->
    <div style="display:flex;gap:12px;align-items:flex-end;">
  <div style="flex:1;display:flex;flex-direction:column;gap:8px;">
    <label style="font-size:14px;color:var(--primary);font-weight:500;">
      Reason for Adjustment
    </label>
    <select id="adjustQtyReason"
      style="width:100%;padding:9px 12px;font-size:13px;border:1px solid #e5e7eb;
      border-radius:4px;background:#f9fafb;color:#111;outline:none;cursor:pointer;">
      <option value="">Select reason...</option>
      <option value="received">Stock Received</option>
      <option value="damaged">Damaged / Rejected</option>
      <option value="returned">Returned to Vendor</option>
      <option value="correction">Correction / Manual Adjust</option>
      <option value="other">Other</option>
    </select>
  </div>
  <!-- Qty -->
  <div style="display:flex;flex-direction:column;gap:8px;">
    <label style="font-size:13px;color:var(--primary);font-weight:600;">
      Qty
    </label>
    <input type="number" id="adjustQtyValue" min="0" placeholder="Enter qty..."
      oninput="updateAdjustPreview()"
      style="width:100%;padding:9px 12px;font-size:13px;border:1px solid #e5e7eb;
      border-radius:4px;background:#f9fafb;color:#111;outline:none;" />
  </div>
</div>

   <!-- Adjustment Type -->
<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
  <label style="font-size:13px;color:var(--primary);font-weight:600;white-space:nowrap;">
    Adjustment Type:
  </label>
  <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:#111;">
    <input type="radio" name="adjustType" value="add" checked
      onchange="updateAdjustPreview()"
      style="accent-color:var(--primary);width:15px;height:15px;" />
    <span style="background:#dcfce7;color:#166534;padding:3px 10px;
      border-radius:20px;font-size:12px;font-weight:600;">+ Add</span>
  </label>
  <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;color:#111;">
    <input type="radio" name="adjustType" value="subtract"
      onchange="updateAdjustPreview()"
      style="accent-color:var(--primary);width:15px;height:15px;" />
    <span style="background:#fee2e2;color:#991b1b;padding:3px 10px;
      border-radius:20px;font-size:12px;font-weight:600;">− Subtract</span>
  </label>
</div>

<!-- Remarks -->
<div style="display:flex;flex-direction:column;gap:8px;">
  <label style="font-size:13px;color:var(--primary);font-weight:600;">
    Remarks
  </label>
  <textarea id="adjustQtyRemarks" placeholder="Enter remarks..."
    style="width:100%;padding:9px 12px;font-size:13px;height:36px;border:1px solid #e5e7eb;
    border-radius:4px;background:#f9fafb;color:#111;outline:none;resize:none;"></textarea>
</div>

    <!-- Preview -->
    <div id="adjustQtyPreview"
      style="display:none;background:#f0fdf4;border:1px solid #bbf7d0;
      border-radius:8px;padding:12px 16px;font-size:13px;color:#166534;font-weight:600;
      display:flex;align-items:center;justify-content:space-between;">
      <span>New Qty will be:</span>
      <span id="adjustQtyPreviewVal"
        style="font-size:20px;font-weight:700;color:#059669;"></span>
    </div>

  </div>

  <!-- Footer -->
  <div style="display:flex;justify-content:flex-end;gap:10px;padding:14px 18px;
    border-top:1px solid #e5e7eb;">
    <button onclick="closeAdjustQtyPopup()"
      style="padding:9px 20px;border:1px solid #e5e7eb;background:#f3f4f6;
      border-radius:5px;font-size:13px;cursor:pointer;color:#374151;">Cancel</button>
    <button onclick="saveAdjustQty()"
      style="padding:9px 22px;border:none;background:var(--primary-color);color:#fff;
      border-radius:5px;font-size:13px;font-weight:600;cursor:pointer;
      display:inline-flex;align-items:center;gap:6px;">
      <i class="fa-solid fa-circle-check"></i> Apply
    </button>
  </div>
</div>
<div id="popupOverlay" onclick="closeStagePopup()"></div>

<div id="stagePopup">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h3 id="popupTitle">Dispatch - Overdue</h3>
    <button class="popup-close" onclick="closeStagePopup()">✕</button>
  </div>
  <table class="popup-table">
    <colgroup>
      <col /><col /><col /><col /><col /><col />
    </colgroup>
    <thead>
      <tr>
        <th>Sl No</th>
        <th>Project ID</th>
        <th>Part No</th>
        <th>Stage Date</th>
        <th>Qty</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="popupTableBody"></tbody>
  </table>
</div>


<!-- External JS -->
<!-- <script src="/js/dashboard-chart.js"></script> -->
<script src="/js/project-management.js"></script>
</body>
</html>