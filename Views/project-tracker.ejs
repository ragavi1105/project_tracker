<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Project Tracker</title>
  <link rel="stylesheet" href="/css/project-tracker.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="icon" type="image/x-icon" href="https://i.ibb.co/FkSK8vZQ/Tracker-light-removebg-preview.png">
</head>
<body>

  <header class="topbar">
    <div class="logo">
      <img src="https://i.ibb.co/Cfm8QDG/Hanav-Logo-Symbol-removebg-preview.png" alt="Project Tracker Logo" class="tracker-logo"/>
      
      <div class="logo-text">
        <h1>Project Tracker</h1>
        <p>Track, manage and deliver projects efficiently</p>
      </div>
    </div>
    <button class="btn-find" onclick="window.location.href='/search-project'">
  <i class="fa-solid fa-magnifying-glass"></i>
  Find Your Project
</button>
    <div class="user-pill">
      <i class="fa-solid fa-user-astronaut"></i>
      <span>Welcome,<br><label class="user-name" id="userName">Divya Dharshini</label></span>
    </div>
  </header>

  <main class="main-content">
    <div class="project-card">

      <!-- Col 1: Project ID -->
      <div class="proj-id-col">
        <div class="proj-icon">
          <i class="fa-solid fa-file-lines"></i>
        </div>
        <div>
          <div class="proj-id-label">Project ID</div>
          <div class="proj-id-val" id="projectId">AM110-AP</div>
        </div>
        <div class="status-badge">
          <span class="status-dot"></span>
          <span id="projectStatus">Active</span>
        </div>
        <div class="created-row">
          <i class="fa-regular fa-calendar"></i>
          Created at&nbsp;<b><label id="createdAt">14 April 2026</label></b>
        </div>
      </div>

      <!-- Col 2: Dates -->
      <div class="dates-col">
        <div class="date-row">
          <label class="date-label" for="startDate">Starting Date</label>
          <div class="date-input-wrap">
            <input type="date" id="startDate"/>
          </div>
        </div>
        <div class="date-row">
          <label class="date-label" for="reqDate">Customer Req Date</label>
          <div class="date-input-wrap">
            <input type="date" id="reqDate"/>
          </div>
        </div>
        <div class="dates-action">
          <button class="btn-date" onclick="saveDates()">Save Dates</button>
          <span class="saved-msg" id="savedDatesMsg">
            <i class="fa-solid fa-circle-check"></i> Dates saved
          </span>
        </div>
      </div>

      <!-- Col 3: People -->
      <div class="people-col">
        <div class="person-row">
          <span class="person-label">Project Manager</span>
          <div class="person-select-wrap">
            <select id="pmSelect">
            </select>
          </div>
        </div>
        <div class="person-row">
          <span class="person-label">Quality Manager</span>
          <div class="person-select-wrap">
            <select id="qmSelect">
            </select>
          </div>
        </div>
        <div class="person-row">
          <span class="person-label">Development Manager</span>
          <div class="person-select-wrap">
            <select id="peSelect">
            </select>
          </div>
        </div>
        <div class="person-row">
          <span class="person-label">Engineer</span>
          <div class="person-input-wrap">
            <input type="text" id="engineerInput" class="engineer-input"placeholder="Enter engineer name..."/>
          </div>
        </div>
        <div class="people-action save-people-btn">
          <button class="btn-save" onclick="savePeople()">Save</button>
          <span class="saved-msg" id="savedPeopleMsg">
            <i class="fa-solid fa-circle-check"></i> Saved
          </span>
        </div>
      </div>
    </div>

    <section class="docs-section">
  <div class="docs-header">
    <div class="docs-title">
      <i class="fa-solid fa-boxes-stacked"></i>
      <h2>Parts & Orders</h2>
    </div>
    <span class="docs-count" id="docsCount">6 parts</span>
  </div>

  <div class="table-wrap">
    <table class="docs-table">
      <thead>
        <tr>
          <th>S.No</th>
          <th>Part Number</th>
          <th>Part Name</th>
          <th>Order Quantity</th>
          <th>Required Date</th>
          <th>Status</th>
          <th>Actions</th>
          <th>Route Card</th>
        </tr>
      </thead>
      <tbody id="partsTableBody"></tbody>
    </table>
  </div>
</section>
</main>

  <!-- RIGHT SIDE VIEW PANEL -->
   <div class="overlay" id="overlay"></div>
<div class="view-panel" id="viewPanel">
  <div class="view-panel-content">

    <div class="view-header">
  <h3>Part Details</h3>

  <div class="header-icons">
    <i class="fa-solid fa-clone"></i>
    <i class="fa-solid fa-share"></i>
    <i class="fa-solid fa-xmark close-icon" onclick="closePanel()"></i>
  </div>
</div>

<div class="view-body">

  <!-- TOP DETAILS -->
  <div class="part-top">
    <div class="part-col">
      <label>Part Name: </label>
      <p id="partName">-</p>
    </div>

    <div class="part-col">
      <label>Order Quantity: </label>
      <p id="partQty">-</p>
    </div>
    <div class="part-col">
  <label>Required Date: </label>
  <input
    type="date" class="required-date"
    id="requiredDate"/> <i class="fa-brands fa-square-xing date-save" onclick="saveRequiredDate()" title="Save Required Date"
    style="cursor:pointer;"></i>
</div>

    <!-- <i class="fa-solid fa-circle-check date-save"></i> -->

    <div class="part-col">
  <label>Upload File: </label>

  <span class="part-files-text">
    Part Files (<span class="file-count">0</span>)
  </span>
</div>
</div>

<div class="tabs">
          <button class="tab active" data-tab="stage">Stages</button>
          <button class="tab" data-tab="document">Documents</button>
        </div>


 <!-- TABS -->

        <!-- STAGES TAB -->
        <div id="stage" class="tab-content active">

          <!-- STAGE 1: DFM Checking — 2 rows -->
          <div class="stage-section" id="section-dfm">
            <div class="stage-section-header">
              <span class="stage-section-title">DFM Checking</span>
              <button class="btn-add" onclick="addRow('tbody-dfm')">
                <i class="fa-solid fa-plus"></i> Add
              </button>
            </div>
            <div class="stage-table-wrap">
              <table class="stage-tbl">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Target Date</th>
                    <th>Actual Date</th>
                    <th>Inward</th>
                    <th>Outward</th>
                    <th>Upload</th>
                    <th>Verifier</th>
                    <th>Remarks</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="tbody-dfm">
                  <!-- 2 default rows for DFM -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- STAGE 2: RM Stage -->
          <div class="stage-section" id="section-rm">
            <div class="stage-section-header">
              <span class="stage-section-title">RM Stage</span>
              <button class="btn-add" onclick="addRow('tbody-rm')">
                <i class="fa-solid fa-plus"></i> Add
              </button>
            </div>
            <div class="stage-table-wrap">
              <table class="stage-tbl">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Target Date</th>
                    <th>Actual Date</th>
                    <th>Inward</th>
                    <th>Outward</th>
                    <th>Upload</th>
                    <th>Verifier</th>
                    <th>Remarks</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="tbody-rm"></tbody>
              </table>
            </div>
            <div class="stage-footer">
            </div>
          </div>

          <!-- STAGE 3: Manufacturing — 1 row -->
      <div class="stage-section" id="section-mfg">
        <div class="stage-section-header">
          <span class="stage-section-title">Manufacturing</span>
          </span>
    <button class="btn-add" onclick="addRow('tbody-mfg')">
      <i class="fa-solid fa-plus"></i> Add
    </button>
            </div>
            <div class="stage-table-wrap">
              <table class="stage-tbl">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Target Date</th>
                    <th>Actual Date</th>
                    <th>Inward</th>
                    <th>Outward</th>
                    <th>Upload</th>
                    <th>Verifier</th>
                    <th>Remarks</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="tbody-mfg">
                </tbody>
              </table>
            </div>
          </div>

          <!-- STAGE 4: Inspection — 1 row -->
         <div class="stage-section" id="section-insp">
  <div class="stage-section-header">
    <span class="stage-section-title">
      Inspection
      <select id="inspVariantSelect""
  style="margin-left:10px; font-size:12px; padding:4px 8px; border:1px solid #e5e7eb;
         border-radius:4px; background:#f9fafb; color:#111; outline:none; cursor:pointer;">
  <option value="" disabled selected>Select Type</option>
  <option value="FAI">FAI</option>
  <option value="PPAP I">PPAP I</option>
  <option value="PPAP II">PPAP II</option>
  <option value="PPAP III">PPAP III</option>
  <option value="PPAP IV">PPAP IV</option>
</select>
    </span>
    <button class="btn-add" onclick="addRow('tbody-insp')" disabled style="opacity:0.4;cursor:not-allowed;">
      <i class="fa-solid fa-plus"></i> Add
    </button>
  </div>
  
            <div class="stage-table-wrap">
              <table class="stage-tbl">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Target Date</th>
                    <th>Actual Date</th>
                    <th>Inward</th>
                    <th>Outward</th>
                    <th>Upload</th>
                    <th>Verifier</th>
                    <th>Remarks</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="tbody-insp">
                </tbody>
              </table>
            </div>
          </div>

          <!-- STAGE 4: Dispatch — 1 row -->
          <div class="stage-section" id="section-disp">
            <div class="stage-section-header">
              <span class="stage-section-title">Dispatch</span>
              <button class="btn-add" onclick="addRow('tbody-disp', loadUsers())">
                <i class="fa-solid fa-plus"></i> Add
              </button>
            </div>
            <div class="stage-table-wrap">
              <table class="stage-tbl">
                <thead>
                  <tr>
                    <th>Stage</th>
                    <th>Target Date</th>
                    <th>Actual Date</th>
                    <th>Inward</th>
                    <th>Outward</th>
                    <th>Upload</th>
                    <th>Verifier</th>
                    <th>Remarks</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="tbody-disp">
                </tbody>
              </table>
            </div>
          </div>

        </div><!-- /stage tab -->

        <!-- DOCUMENTS TAB -->
        <div id="document" class="tab-content">
          <div id="documentsContainer"></div>
        </div>

    </div>
  </div>

  <!-- ===== ADDED: REMARKS POPUP (positioned near clicked field via JS) ===== -->
 <div id="remarksOverlay" class="remarks-overlay-bg"></div>

<div id="remarksPopup" class="remarks-popup" style="display:none; height:auto;">

  <div id="remarksHistory"></div>

  <div class="remarks-popup-actions">
    <button class="remarks-btn-cancel" onclick="closeRemarksPopup()">Cancel</button>
  </div>

</div>

  <!-- ===== ADDED: UPLOAD FILES POPUP ===== -->
  <div class="upload-popup-overlay" id="uploadPopupOverlay" onclick="closeUploadPopup()"></div>
  <div class="upload-popup" id="uploadPopup">
    <div class="upload-popup-header">
      <div class="upload-popup-title">
        <i class="fa-solid fa-folder-open"></i>
        <span>Project Files</span>
      </div>
      <i class="fa-solid fa-xmark upload-popup-close" onclick="closeUploadPopup()"></i>
    </div>
    <div class="upload-popup-body">
      <div class="upload-drop-zone" onclick="document.getElementById('stageFilePicker').click()">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <p>Click to choose files</p>
        <span>PDF, DWG, XLSX, images and more</span>
      </div>
      <input type="file" id="stageFilePicker" multiple style="display:none;" onchange="handleStageFiles(this)" />
      <table class="upload-files-table">
        <thead>
          <tr>
            <th>File Name</th>
            <th>File Type</th>
            <th>Remarks</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="uploadFilesTbody">
          <tr id="uploadEmptyRow">
            <td colspan="4" class="upload-empty-cell">No files added yet</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="upload-popup-footer">
      <button class="upload-btn-cancel" onclick="closeUploadPopup()">Cancel</button>
      <button class="upload-btn-insert" onclick="insertFiles()">
        <i class="fa-solid fa-circle-check"></i> Insert Files
      </button>
    </div>
  </div>

  <!-- ===== ADDED: FIND PROJECT MODAL ===== -->
  <div class="find-modal-overlay" id="findModalOverlay" onclick="closeFindModal()"></div>
  <div class="find-modal" id="findModal">
    <div class="find-modal-top">
      <div class="find-modal-icon-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
      </div>
      <h2>Find Your Project</h2>
      <p>Enter a project ID to view progress and updates</p>
    </div>
    <div class="find-modal-body">
      <input type="text" id="findModalInput" class="find-modal-input" placeholder="Enter here..."
             onkeydown="if(event.key==='Enter') doFindProject()" />
      <p class="find-modal-error" id="findModalError"></p>
      <button class="find-modal-search-btn" onclick="doFindProject()">
        <i class="fa-solid fa-magnifying-glass"></i> Search
      </button>
      <button class="find-modal-cancel-btn" onclick="closeFindModal()">Cancel</button>
    </div>
  </div>

  <!-- Alert Popup Overlay -->
<div id="alertPopupOverlay"></div>

<!-- Alert Popup -->
<div id="alertPopup">

  <!-- Header -->
  <div class="popup-header">
    <div class="popup-title">
      <i class="fa-solid fa-circle-exclamation alert-icon"></i>
      <span>Verify Stage</span>
    </div>
    <i class="fa-solid fa-xmark popup-close" onclick="closeAlertPopup()"></i>
  </div>

  <!-- Body -->
<div class="popup-body">

  <div class="project-id">
    <label>Project ID:</label>
    <span id="alertProjectId">(AM110-AP)</span>
  </div>

          <!-- Approver -->
          <div class="popup-field">
            <label>
              Approver Name 
            </label>
            <input 
              type="text" 
              id="alertApproverInput"
              placeholder="Enter approver name..."
            />
          </div>

          <!-- Remarks -->
          <div class="popup-field">
            <label>
              Remarks 
            </label>
            <textarea 
              id="alertRemarksInput"
              placeholder="Enter remarks..."
              rows="3"
            ></textarea>
          </div>

        </div>

        <!-- Footer -->
        <div class="verify-popup-footer">
          <button onclick="closeAlertPopup()" class="btn-cancel">
            Cancel
          </button>
          <button onclick="saveAlertPopup()" class="verify-btn-save">
            Save Alert
          </button>
        </div>

      </div>
      
<div id="verifyConfirmOverlay" class="verify-overlay"></div>

<div id="verifyConfirmPopup" class="verify-popup">
  <div class="verify-header">
    <div class="verify-title">
      Verified by <span id="verifyConfirmApprover">—</span>
    </div>
    <button class="verify-close" onclick="closeVerifyConfirmPopup()">&times;</button>
  </div>
   <div class="project-id" style="margin:10px 0 5px 15px;">
    <label>Project ID:</label>
    <span id="alertProjectId">(AM110-AP)</span>
  </div>

  <div class="verify-body">
    <div class="verify-label">Verifier Remarks</div>
    <div id="verifyConfirmRemarks" class="verify-remarks">—</div>
  </div>
  <!-- <div class="verify-footer">
    <button class="verify-btn" onclick="closeVerifyConfirmPopup()">Close</button>
  </div> -->
</div>

<!-- SUCCESS POPUP -->
<div id="verifySuccessOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:9998;"></div>
<div id="verifySuccessPopup" style="display:none;position:fixed;top:50%;left:50%;
  transform:translate(-50%,-50%);background:#fff;border-radius:10px;padding:32px 28px;
  text-align:center;z-index:9999;width:320px;box-shadow:0 10px 40px rgba(0,0,0,0.18);">
  <div style="font-size:17px;font-weight:600;color:#111;margin-bottom:8px;">Stage Verified Successfully</div>
  <div style="font-size:13px;color:#777;margin-bottom:24px;">
    The alert has been saved and the stage is now marked as verified.
  </div>
  <button onclick="closeSuccessPopup()"
    style="padding:10px 36px;border-radius:6px;border:none;background:#e05c5c;
           color:#fff;cursor:pointer;font-size:14px;font-weight:500;">OK</button>
</div>

  <script src="/js/project-tracker.js"></script>
</body>
</html>